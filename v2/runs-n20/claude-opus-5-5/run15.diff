diff --git a/k8s/vllm-deployment.yaml b/k8s/vllm-deployment.yaml
index 4ee2bc2..822096f 100644
--- a/k8s/vllm-deployment.yaml
+++ b/k8s/vllm-deployment.yaml
@@ -15,12 +15,16 @@ spec:
       labels:
         app: vllm
     spec:
+      # The Service is named "vllm", so service links would inject
+      # VLLM_PORT=tcp://<ip>:8000 etc. into this pod. vLLM reads VLLM_PORT
+      # as its own config and refuses to start on a URI value.
+      enableServiceLinks: false
       containers:
         - name: vllm
           image: vllm/vllm-openai:v0.10.2
+          # The image ENTRYPOINT is already the OpenAI API server, so args
+          # start with the model path (same as the docker run command).
           args:
-            - vllm
-            - serve
             - /models/financial-lora
             - --served-model-name
             - financial-lora
@@ -46,10 +50,18 @@ spec:
             limits:
               nvidia.com/gpu: 1
           volumeMounts:
+            # Equivalent of docker --ipc=host: the default 64Mi /dev/shm is
+            # too small for PyTorch/NCCL shared memory.
+            - name: dshm
+              mountPath: /dev/shm
             - name: model
               mountPath: /models/financial-lora
               readOnly: true
       volumes:
+        - name: dshm
+          emptyDir:
+            medium: Memory
+            sizeLimit: 8Gi
         - name: model
           hostPath:
             path: /home/ubuntu/models/qwen-ft
