diff --git a/k8s/vllm-deployment.yaml b/k8s/vllm-deployment.yaml
index 4ee2bc2..4347fc0 100644
--- a/k8s/vllm-deployment.yaml
+++ b/k8s/vllm-deployment.yaml
@@ -15,12 +15,16 @@ spec:
       labels:
         app: vllm
     spec:
+      # A Service named "vllm" makes Kubernetes inject VLLM_PORT=tcp://<ip>:8000
+      # (and other VLLM_* vars) into pods, which vLLM reads as its own config
+      # and refuses to start. Turn off service-link env injection.
+      enableServiceLinks: false
       containers:
         - name: vllm
           image: vllm/vllm-openai:v0.10.2
+          # The image entrypoint is already the OpenAI API server; pass only its
+          # arguments, same as the working `docker run`.
           args:
-            - vllm
-            - serve
             - /models/financial-lora
             - --served-model-name
             - financial-lora
@@ -49,7 +53,15 @@ spec:
             - name: model
               mountPath: /models/financial-lora
               readOnly: true
+            # Stand-in for `docker run --ipc=host`: the default 64Mi /dev/shm
+            # is too small for PyTorch/NCCL shared memory.
+            - name: dshm
+              mountPath: /dev/shm
       volumes:
+        - name: dshm
+          emptyDir:
+            medium: Memory
+            sizeLimit: 8Gi
         - name: model
           hostPath:
             path: /home/ubuntu/models/qwen-ft
