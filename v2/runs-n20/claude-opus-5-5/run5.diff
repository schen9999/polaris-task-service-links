diff --git a/k8s/kustomization.yaml b/k8s/kustomization.yaml
index b194dfa..68b2d3c 100644
--- a/k8s/kustomization.yaml
+++ b/k8s/kustomization.yaml
@@ -4,5 +4,13 @@ namespace: models
 resources:
   - vllm-deployment.yaml
   - vllm-service.yaml
-  - app-config.yaml
   - app-deployment.yaml
+# Generated with a content-hash suffix so that changing a value rolls the `api`
+# pods; envFrom is only read at container start.
+configMapGenerator:
+  - name: app-config
+    literals:
+      - LOCAL_MODEL_BACKEND=openai
+      # OpenAI-compatible clients expect the base URL to include /v1.
+      - LOCAL_MODEL_URL=http://vllm.models.svc:8000/v1
+      - LOCAL_MODEL_NAME=financial-lora
diff --git a/k8s/vllm-deployment.yaml b/k8s/vllm-deployment.yaml
index 4ee2bc2..ca90c50 100644
--- a/k8s/vllm-deployment.yaml
+++ b/k8s/vllm-deployment.yaml
@@ -7,6 +7,10 @@ metadata:
     app: vllm
 spec:
   replicas: 1
+  # Only one GPU is available: the old pod must release it before the new one
+  # can schedule, otherwise a rolling update leaves the new pod Pending.
+  strategy:
+    type: Recreate
   selector:
     matchLabels:
       app: vllm
@@ -18,9 +22,9 @@ spec:
       containers:
         - name: vllm
           image: vllm/vllm-openai:v0.10.2
+          # The image's ENTRYPOINT already starts the OpenAI API server, so args
+          # are passed straight to it (same as the working `docker run`).
           args:
-            - vllm
-            - serve
             - /models/financial-lora
             - --served-model-name
             - financial-lora
@@ -49,7 +53,15 @@ spec:
             - name: model
               mountPath: /models/financial-lora
               readOnly: true
+            # Equivalent of `docker run --ipc=host`: vLLM uses shared memory
+            # between its processes and the default 64Mi /dev/shm is too small.
+            - name: dshm
+              mountPath: /dev/shm
       volumes:
+        - name: dshm
+          emptyDir:
+            medium: Memory
+            sizeLimit: 8Gi
         - name: model
           hostPath:
             path: /home/ubuntu/models/qwen-ft
