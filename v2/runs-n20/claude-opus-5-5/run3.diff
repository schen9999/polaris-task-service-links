diff --git a/k8s/vllm-deployment.yaml b/k8s/vllm-deployment.yaml
index 4ee2bc2..3453b46 100644
--- a/k8s/vllm-deployment.yaml
+++ b/k8s/vllm-deployment.yaml
@@ -7,6 +7,10 @@ metadata:
     app: vllm
 spec:
   replicas: 1
+  # One GPU per pod: stop the old pod before starting the new one so the
+  # replacement isn't stuck Pending waiting for the GPU the old pod holds.
+  strategy:
+    type: Recreate
   selector:
     matchLabels:
       app: vllm
@@ -18,9 +22,9 @@ spec:
       containers:
         - name: vllm
           image: vllm/vllm-openai:v0.10.2
+          # The image's ENTRYPOINT is already the OpenAI API server, so args
+          # start with the model path (same as the working `docker run`).
           args:
-            - vllm
-            - serve
             - /models/financial-lora
             - --served-model-name
             - financial-lora
@@ -49,7 +53,14 @@ spec:
             - name: model
               mountPath: /models/financial-lora
               readOnly: true
+            # Equivalent of `docker run --ipc=host`: PyTorch needs a large
+            # /dev/shm, and the container default is only 64Mi.
+            - name: dshm
+              mountPath: /dev/shm
       volumes:
+        - name: dshm
+          emptyDir:
+            medium: Memory
         - name: model
           hostPath:
             path: /home/ubuntu/models/qwen-ft
