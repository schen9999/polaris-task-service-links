diff --git a/k8s/vllm-deployment.yaml b/k8s/vllm-deployment.yaml
index 4ee2bc2..83be71d 100644
--- a/k8s/vllm-deployment.yaml
+++ b/k8s/vllm-deployment.yaml
@@ -7,6 +7,10 @@ metadata:
     app: vllm
 spec:
   replicas: 1
+  # Stop the old pod before starting the new one, so a rollout never needs a
+  # second free GPU (a surged pod would sit Pending waiting for one).
+  strategy:
+    type: Recreate
   selector:
     matchLabels:
       app: vllm
@@ -18,9 +22,9 @@ spec:
       containers:
         - name: vllm
           image: vllm/vllm-openai:v0.10.2
+          # The image's ENTRYPOINT is already the OpenAI API server, so args
+          # start at the model path (same as the working `docker run`).
           args:
-            - vllm
-            - serve
             - /models/financial-lora
             - --served-model-name
             - financial-lora
@@ -49,8 +53,16 @@ spec:
             - name: model
               mountPath: /models/financial-lora
               readOnly: true
+            # Equivalent of `docker run --ipc=host`: the default 64Mi /dev/shm
+            # is too small for vLLM / PyTorch shared-memory IPC.
+            - name: dshm
+              mountPath: /dev/shm
       volumes:
         - name: model
           hostPath:
             path: /home/ubuntu/models/qwen-ft
             type: Directory
+        - name: dshm
+          emptyDir:
+            medium: Memory
+            sizeLimit: 8Gi
