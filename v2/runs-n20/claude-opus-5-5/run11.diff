diff --git a/k8s/vllm-deployment.yaml b/k8s/vllm-deployment.yaml
index 4ee2bc2..f70622b 100644
--- a/k8s/vllm-deployment.yaml
+++ b/k8s/vllm-deployment.yaml
@@ -7,6 +7,9 @@ metadata:
     app: vllm
 spec:
   replicas: 1
+  # The pod holds the node's GPU; a surge pod could never schedule next to it.
+  strategy:
+    type: Recreate
   selector:
     matchLabels:
       app: vllm
@@ -18,9 +21,8 @@ spec:
       containers:
         - name: vllm
           image: vllm/vllm-openai:v0.10.2
+          # The image entrypoint is already the OpenAI api_server; pass only its args.
           args:
-            - vllm
-            - serve
             - /models/financial-lora
             - --served-model-name
             - financial-lora
@@ -49,7 +51,14 @@ spec:
             - name: model
               mountPath: /models/financial-lora
               readOnly: true
+            # Stands in for `docker run --ipc=host`; the default 64Mi /dev/shm is too small.
+            - name: dshm
+              mountPath: /dev/shm
       volumes:
+        - name: dshm
+          emptyDir:
+            medium: Memory
+            sizeLimit: 8Gi
         - name: model
           hostPath:
             path: /home/ubuntu/models/qwen-ft
