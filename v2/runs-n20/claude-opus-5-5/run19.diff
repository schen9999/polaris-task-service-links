diff --git a/k8s/vllm-deployment.yaml b/k8s/vllm-deployment.yaml
index 4ee2bc2..1f4c69f 100644
--- a/k8s/vllm-deployment.yaml
+++ b/k8s/vllm-deployment.yaml
@@ -7,6 +7,10 @@ metadata:
     app: vllm
 spec:
   replicas: 1
+  # The pod holds the node's only GPU; a rolling update would leave the new
+  # pod Pending until the old one exits, so tear down first.
+  strategy:
+    type: Recreate
   selector:
     matchLabels:
       app: vllm
@@ -18,9 +22,9 @@ spec:
       containers:
         - name: vllm
           image: vllm/vllm-openai:v0.10.2
+          # The image ENTRYPOINT already runs the OpenAI api_server, so args
+          # start at the model path (same as the working `docker run`).
           args:
-            - vllm
-            - serve
             - /models/financial-lora
             - --served-model-name
             - financial-lora
@@ -49,7 +53,15 @@ spec:
             - name: model
               mountPath: /models/financial-lora
               readOnly: true
+            # Equivalent of `docker run --ipc=host`: the default 64Mi /dev/shm
+            # is too small for PyTorch/NCCL shared memory.
+            - name: dshm
+              mountPath: /dev/shm
       volumes:
+        - name: dshm
+          emptyDir:
+            medium: Memory
+            sizeLimit: 8Gi
         - name: model
           hostPath:
             path: /home/ubuntu/models/qwen-ft
