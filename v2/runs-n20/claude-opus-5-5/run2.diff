diff --git a/k8s/vllm-deployment.yaml b/k8s/vllm-deployment.yaml
index 4ee2bc2..5470c67 100644
--- a/k8s/vllm-deployment.yaml
+++ b/k8s/vllm-deployment.yaml
@@ -7,6 +7,9 @@ metadata:
     app: vllm
 spec:
   replicas: 1
+  # One GPU: the old pod must release it before the new one can schedule.
+  strategy:
+    type: Recreate
   selector:
     matchLabels:
       app: vllm
@@ -18,9 +21,9 @@ spec:
       containers:
         - name: vllm
           image: vllm/vllm-openai:v0.10.2
+          # The image ENTRYPOINT is already the OpenAI api_server, so args
+          # start with the model, exactly as in `docker run`.
           args:
-            - vllm
-            - serve
             - /models/financial-lora
             - --served-model-name
             - financial-lora
@@ -49,7 +52,14 @@ spec:
             - name: model
               mountPath: /models/financial-lora
               readOnly: true
+            # Equivalent of `docker run --ipc=host`; the default 64Mi /dev/shm
+            # is too small for vLLM/NCCL shared memory.
+            - name: dshm
+              mountPath: /dev/shm
       volumes:
+        - name: dshm
+          emptyDir:
+            medium: Memory
         - name: model
           hostPath:
             path: /home/ubuntu/models/qwen-ft
