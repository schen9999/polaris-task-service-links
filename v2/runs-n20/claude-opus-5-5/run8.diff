diff --git a/k8s/vllm-deployment.yaml b/k8s/vllm-deployment.yaml
index 4ee2bc2..1ff5d7e 100644
--- a/k8s/vllm-deployment.yaml
+++ b/k8s/vllm-deployment.yaml
@@ -7,6 +7,10 @@ metadata:
     app: vllm
 spec:
   replicas: 1
+  # Only one GPU is available: a rolling update would leave the new pod
+  # Pending while the old one holds the GPU, so stop the old pod first.
+  strategy:
+    type: Recreate
   selector:
     matchLabels:
       app: vllm
@@ -18,9 +22,9 @@ spec:
       containers:
         - name: vllm
           image: vllm/vllm-openai:v0.10.2
+          # The image's entrypoint already runs the OpenAI API server, so args
+          # are appended to it (same as the docker run command); no "vllm serve".
           args:
-            - vllm
-            - serve
             - /models/financial-lora
             - --served-model-name
             - financial-lora
@@ -49,7 +53,15 @@ spec:
             - name: model
               mountPath: /models/financial-lora
               readOnly: true
+            # Equivalent of docker's --ipc=host: the default 64Mi /dev/shm is
+            # too small for vLLM's shared-memory IPC between processes.
+            - name: dshm
+              mountPath: /dev/shm
       volumes:
+        - name: dshm
+          emptyDir:
+            medium: Memory
+            sizeLimit: 2Gi
         - name: model
           hostPath:
             path: /home/ubuntu/models/qwen-ft
