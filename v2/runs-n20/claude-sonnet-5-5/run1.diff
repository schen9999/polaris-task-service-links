diff --git a/k8s/vllm-deployment.yaml b/k8s/vllm-deployment.yaml
index 4ee2bc2..136825a 100644
--- a/k8s/vllm-deployment.yaml
+++ b/k8s/vllm-deployment.yaml
@@ -7,6 +7,10 @@ metadata:
     app: vllm
 spec:
   replicas: 1
+  # One GPU: a rolling update would start the new pod while the old one still
+  # holds the GPU, leaving it Pending. Stop the old pod first.
+  strategy:
+    type: Recreate
   selector:
     matchLabels:
       app: vllm
@@ -15,12 +19,13 @@ spec:
       labels:
         app: vllm
     spec:
+      # The Service is named "vllm", so Kubernetes would inject VLLM_PORT=tcp://...
+      # which vLLM reads as its own (integer) setting and fails on.
+      enableServiceLinks: false
       containers:
         - name: vllm
           image: vllm/vllm-openai:v0.10.2
           args:
-            - vllm
-            - serve
             - /models/financial-lora
             - --served-model-name
             - financial-lora
@@ -36,6 +41,12 @@ spec:
           env:
             - name: HF_HUB_OFFLINE
               value: "1"
+          startupProbe:
+            httpGet:
+              path: /health
+              port: http
+            periodSeconds: 10
+            failureThreshold: 90
           readinessProbe:
             httpGet:
               path: /health
@@ -49,7 +60,14 @@ spec:
             - name: model
               mountPath: /models/financial-lora
               readOnly: true
+            - name: shm
+              mountPath: /dev/shm
       volumes:
+        # Replaces `docker run --ipc=host`; the default 64Mi /dev/shm is too small.
+        - name: shm
+          emptyDir:
+            medium: Memory
+            sizeLimit: 8Gi
         - name: model
           hostPath:
             path: /home/ubuntu/models/qwen-ft
