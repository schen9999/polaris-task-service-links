diff --git a/k8s/vllm-deployment.yaml b/k8s/vllm-deployment.yaml
index 4ee2bc2..271d251 100644
--- a/k8s/vllm-deployment.yaml
+++ b/k8s/vllm-deployment.yaml
@@ -15,12 +15,13 @@ spec:
       labels:
         app: vllm
     spec:
+      # Service "vllm" would otherwise inject VLLM_PORT=tcp://<ip>:8000 into this pod,
