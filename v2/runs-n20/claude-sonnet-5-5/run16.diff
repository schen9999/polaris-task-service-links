diff --git a/k8s/vllm-deployment.yaml b/k8s/vllm-deployment.yaml
index 4ee2bc2..2669cad 100644
--- a/k8s/vllm-deployment.yaml
+++ b/k8s/vllm-deployment.yaml
@@ -15,12 +15,12 @@ spec:
       labels:
         app: vllm
     spec:
+      # Service "vllm" would otherwise inject VLLM_PORT=tcp://<ip>:8000, which vLLM reads as its own config
+      enableServiceLinks: false
       containers:
         - name: vllm
           image: vllm/vllm-openai:v0.10.2
           args:
-            - vllm
-            - serve
             - /models/financial-lora
             - --served-model-name
             - financial-lora
@@ -36,6 +36,12 @@ spec:
           env:
             - name: HF_HUB_OFFLINE
               value: "1"
+          startupProbe:
+            httpGet:
+              path: /health
+              port: http
+            periodSeconds: 10
+            failureThreshold: 60
           readinessProbe:
             httpGet:
               path: /health
@@ -49,7 +55,14 @@ spec:
             - name: model
               mountPath: /models/financial-lora
               readOnly: true
+            - name: shm
+              mountPath: /dev/shm
       volumes:
+        # equivalent of --ipc=host: default 64Mi /dev/shm is too small for vLLM
+        - name: shm
+          emptyDir:
+            medium: Memory
+            sizeLimit: 8Gi
         - name: model
           hostPath:
             path: /home/ubuntu/models/qwen-ft
