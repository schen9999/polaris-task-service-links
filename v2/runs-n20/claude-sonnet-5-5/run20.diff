           env:
             - name: HF_HUB_OFFLINE
               value: "1"
+          startupProbe:
+            httpGet:
+              path: /health
+              port: http
+            periodSeconds: 10
+            failureThreshold: 60
           readinessProbe:
             httpGet:
               path: /health
@@ -49,7 +58,13 @@ spec:
             - name: model
               mountPath: /models/financial-lora
               readOnly: true
+            - name: shm
+              mountPath: /dev/shm
       volumes:
