diff --git a/k8s/vllm-deployment.yaml b/k8s/vllm-deployment.yaml
index 4ee2bc2..e6cf45b 100644
--- a/k8s/vllm-deployment.yaml
+++ b/k8s/vllm-deployment.yaml
@@ -18,9 +18,11 @@ spec:
       containers:
         - name: vllm
           image: vllm/vllm-openai:v0.10.2
+          # The image's ENTRYPOINT already runs the OpenAI API server, so
+          # `args` must start with the model path, exactly as in the
+          # working `docker run` (which passes everything after the image).
+          # Do not add `vllm serve` here or set `command:`.
           args:
-            - vllm
-            - serve
             - /models/financial-lora
             - --served-model-name
             - financial-lora
@@ -49,8 +51,16 @@ spec:
             - name: model
               mountPath: /models/financial-lora
               readOnly: true
+            # Equivalent of `docker run --ipc=host`. vLLM uses shared memory
+            # for worker communication; the default 64Mi /dev/shm is too
+            # small and makes it crash.
+            - name: dshm
+              mountPath: /dev/shm
       volumes:
         - name: model
           hostPath:
             path: /home/ubuntu/models/qwen-ft
             type: Directory
+        - name: dshm
+          emptyDir:
+            medium: Memory
