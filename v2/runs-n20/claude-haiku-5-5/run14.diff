diff --git a/k8s/vllm-deployment.yaml b/k8s/vllm-deployment.yaml
index 4ee2bc2..8f2fb04 100644
--- a/k8s/vllm-deployment.yaml
+++ b/k8s/vllm-deployment.yaml
@@ -18,9 +18,10 @@ spec:
       containers:
         - name: vllm
           image: vllm/vllm-openai:v0.10.2
+          # The vllm/vllm-openai image's entrypoint is already the OpenAI API
+          # server, so args are passed straight to it (same as the docker run
+          # command, which has no "vllm serve" prefix).
           args:
-            - vllm
-            - serve
             - /models/financial-lora
             - --served-model-name
             - financial-lora
@@ -49,8 +50,16 @@ spec:
             - name: model
               mountPath: /models/financial-lora
               readOnly: true
+            # Equivalent of docker's --ipc=host: vLLM needs a large /dev/shm.
+            # The default 64Mi causes worker/shared-memory failures.
+            - name: dshm
+              mountPath: /dev/shm
       volumes:
         - name: model
           hostPath:
             path: /home/ubuntu/models/qwen-ft
             type: Directory
+        - name: dshm
+          emptyDir:
+            medium: Memory
+            sizeLimit: 8Gi
