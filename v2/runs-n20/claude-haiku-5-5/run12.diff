diff --git a/k8s/vllm-deployment.yaml b/k8s/vllm-deployment.yaml
index 4ee2bc2..9ab9090 100644
--- a/k8s/vllm-deployment.yaml
+++ b/k8s/vllm-deployment.yaml
@@ -7,6 +7,11 @@ metadata:
     app: vllm
 spec:
   replicas: 1
+  # Recreate: the old pod must release the only GPU before the new pod can
+  # be scheduled. The default RollingUpdate would leave the new pod Pending
+  # on a single-GPU node.
+  strategy:
+    type: Recreate
   selector:
     matchLabels:
       app: vllm
@@ -18,9 +23,11 @@ spec:
       containers:
         - name: vllm
           image: vllm/vllm-openai:v0.10.2
+          # The image's ENTRYPOINT already runs the OpenAI API server, so
+          # args are only its flags and the model path. Do not prepend
+          # "vllm serve" here; that is what produced
+          # "unrecognized arguments: serve /models/financial-lora".
           args:
-            - vllm
-            - serve
             - /models/financial-lora
             - --served-model-name
             - financial-lora
@@ -36,11 +43,18 @@ spec:
           env:
             - name: HF_HUB_OFFLINE
               value: "1"
+          # Model load can take minutes; give startup a generous budget so
+          # readiness/liveness do not gate it.
+          startupProbe:
+            httpGet:
+              path: /health
+              port: http
+            periodSeconds: 10
+            failureThreshold: 90
           readinessProbe:
             httpGet:
               path: /health
               port: http
-            initialDelaySeconds: 30
             periodSeconds: 10
           resources:
             limits:
@@ -49,8 +63,16 @@ spec:
             - name: model
               mountPath: /models/financial-lora
               readOnly: true
+            # Equivalent of docker's --ipc=host for vLLM. Without it the
+            # pod gets the 64Mi default /dev/shm, which vLLM can fail on.
+            - name: dshm
+              mountPath: /dev/shm
       volumes:
         - name: model
           hostPath:
             path: /home/ubuntu/models/qwen-ft
             type: Directory
+        - name: dshm
+          emptyDir:
+            medium: Memory
+            sizeLimit: 8Gi
