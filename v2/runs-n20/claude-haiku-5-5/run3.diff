diff --git a/k8s/vllm-deployment.yaml b/k8s/vllm-deployment.yaml
index 4ee2bc2..e83a643 100644
--- a/k8s/vllm-deployment.yaml
+++ b/k8s/vllm-deployment.yaml
@@ -18,9 +18,9 @@ spec:
       containers:
         - name: vllm
           image: vllm/vllm-openai:v0.10.2
+          # The image's ENTRYPOINT is already the OpenAI API server, so args
+          # start at the model path. Do not prefix with "vllm serve".
           args:
-            - vllm
-            - serve
             - /models/financial-lora
             - --served-model-name
             - financial-lora
@@ -49,8 +49,16 @@ spec:
             - name: model
               mountPath: /models/financial-lora
               readOnly: true
+            # Equivalent of `docker run --ipc=host`: vLLM needs more shared
+            # memory than the 64Mi default /dev/shm in a pod.
+            - name: dshm
+              mountPath: /dev/shm
       volumes:
         - name: model
           hostPath:
             path: /home/ubuntu/models/qwen-ft
             type: Directory
+        - name: dshm
+          emptyDir:
+            medium: Memory
+            sizeLimit: 8Gi
